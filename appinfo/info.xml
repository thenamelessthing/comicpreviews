<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>comicpreviews</id>
    <name>Comic Previews</name>
    <summary>Generate previews for comic archives</summary>
    <description>Bounded preview provider for CBZ archives and, when the optional PHP RAR extension is installed, CBR archives. It selects the first naturally ordered JPEG, PNG, GIF, or WebP image without invoking external archive utilities.</description>
    <version>0.2.0</version>
    <licence>agpl</licence>
    <author>thenamelessthing</author>
    <author homepage="https://github.com/devnoname120">devnoname120</author>
    <namespace>Comicpreviews</namespace>
    <category>files</category>
    <category>multimedia</category>
    <website>https://github.com/devnoname120/comicpreviews</website>
    <bugs>https://github.com/devnoname120/comicpreviews/issues</bugs>
    <dependencies>
        <php min-version="8.2" max-version="8.5" />
        <lib>zip</lib>
        <nextcloud min-version="34" max-version="35" />
    </dependencies>
</info>
